# ===== AIP 环境变量模板 =====
# 复制为 .env 并填写实际值。含密钥的 .env 绝不提交版本库。

# runtime 与控制台 BFF 之间的共享密钥（必填，生产环境用强随机值）
OS_SECURITY_KEY=change-me-strong-random-key

# 演示 Agent 的模型凭证（OpenAI 官方 API）
OPENAI_API_KEY=
# 演示 Agent 使用的模型
DEMO_MODEL_ID=gpt-4.1-mini

# 国内网络访问 OpenAI/Anthropic 官方端点所需代理（runtime 容器内生效，可留空）
HTTP_PROXY=
HTTPS_PROXY=
