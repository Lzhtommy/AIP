# ===== AIP 环境变量模板 =====
# 复制为 .env 并填写实际值。含密钥的 .env 绝不提交版本库。

# runtime 与控制台 BFF 之间的共享密钥（必填，生产环境用强随机值）
OS_SECURITY_KEY=change-me-strong-random-key

# 模型 provider：openai（默认）或 anthropic
MODEL_PROVIDER=openai
# 对应 provider 的模型凭证（填与 MODEL_PROVIDER 匹配的那个）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 模型 ID；留空按 provider 取默认（openai→gpt-4.1-mini，anthropic→claude-opus-4-8）
DEMO_MODEL_ID=
# 知识库向量化依赖 OpenAI embedding —— 即使 MODEL_PROVIDER=anthropic，
# 使用 Knowledge 功能也需配置 OPENAI_API_KEY（Anthropic 无 embedding API）

# 国内网络访问 OpenAI/Anthropic 官方端点所需代理（runtime 容器内生效，可留空）
HTTP_PROXY=
HTTPS_PROXY=

# 控制台自身数据库（用户/端点配置；与 runtime 同 PG 实例、独立 database）
DATABASE_URL=postgresql://ai:ai@localhost:5532/console
# Auth.js 会话签名密钥（必填，生产用 openssl rand -base64 32 生成）
AUTH_SECRET=change-me-random-secret
# 端点 Security Key 的静态加密密钥（必填；丢失后已存端点密钥不可恢复，注意备份）
ENCRYPTION_KEY=change-me-random-encryption-key

# OAuth 登录（可选：配置后登录页自动出现对应按钮；回调地址填 <控制台地址>/api/auth/callback/<provider>）
# 注意：Google OAuth 在国内网络可能不可达（登录跳转需访问 google.com），GitHub 通常正常
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
